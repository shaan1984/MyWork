<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:text="⚡\nELEMENTAL\nPOWERS"
        android:textAlignment="center"
        android:textColor="#FFFFFF"
        android:textSize="40sp"
        android:textStyle="bold"
        android:lineSpacingMultiplier="1.1" />

    <TextView
        android:id="@+id/subtitleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Master the Elements. Defeat your foes."
        android:textAlignment="center"
        android:textColor="#AAAAAA"
        android:textSize="14sp" />

    <View
        android:layout_width="200dp"
        android:layout_height="1dp"
        android:layout_marginTop="36dp"
        android:layout_marginBottom="36dp"
        android:background="#444444" />

    <Button
        android:id="@+id/btnStartGame"
        android:layout_width="240dp"
        android:layout_height="56dp"
        android:backgroundTint="#FF4500"
        android:text="⚔️  START BATTLE"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnHowToPlay"
        android:layout_width="240dp"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="#1E3A5F"
        android:text="📖  HOW TO PLAY"
        android:textColor="#FFFFFF"
        android:textSize="17sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:text="🔥 Fire  💧 Water  🌍 Earth  ❄️ Ice\n🌿 Life  ⚡ Tech  ☀️ Heat  💥 Earthquake"
        android:textAlignment="center"
        android:textColor="#666666"
        android:textSize="12sp"
        android:lineSpacingMultiplier="1.4" />

</LinearLayout>
