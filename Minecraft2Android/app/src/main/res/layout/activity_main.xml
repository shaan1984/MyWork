<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <ImageView
        android:id="@+id/menuBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.4"
        android:contentDescription="Background" />

    <LinearLayout
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="#CC000000">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MINECRAFT 2"
            android:textSize="32sp"
            android:textColor="#44FF44"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="A New Dimension"
            android:textSize="14sp"
            android:textColor="#AAAAAA"
            android:gravity="center"
            android:layout_marginBottom="32dp" />

        <Button
            android:id="@+id/btnPlay"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/main_menu_play"
            android:textSize="18sp"
            android:backgroundTint="#2D5A27"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/main_menu_settings"
            android:textSize="18sp"
            android:backgroundTint="#4A4A4A"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnAbout"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/main_menu_about"
            android:textSize="18sp"
            android:backgroundTint="#4A4A4A"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnQuit"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/main_menu_quit"
            android:textSize="18sp"
            android:backgroundTint="#8B1A1A"
            android:layout_marginBottom="0dp" />
    </LinearLayout>

</RelativeLayout>
